# =============================================================================
# Environment Variable Configuration for fibcalc
# =============================================================================
# This file lists all environment variables supported by the application.
# Copy this file to .env and modify the values according to your needs.
#
# Configuration priority for every setting EXCEPT the three thresholds:
#   1. Command line arguments (CLI flags)
#   2. Environment variables (this file) — read only when the matching flag is
#      absent from the command line (internal/config/env.go:applyEnvOverrides)
#   3. Static default values
#
# THE THREE THRESHOLDS have one extra step. A valid cached calibration profile
# fills FIBCALC_THRESHOLD / FIBCALC_FFT_THRESHOLD / FIBCALC_STRASSEN_THRESHOLD
# (and their --threshold / --fft-threshold / --strassen-threshold flags) only
# when you did NOT set them: app.New calls calibration.LoadCachedCalibration
# after ParseConfig, and it skips every threshold ParseConfig marked explicit
# (internal/config/thresholds.go). When no valid profile is found,
# ApplyAdaptiveThresholds runs instead and fills only thresholds still at 0.
#
# Before the 2026-09 audit the profile overwrote all three unconditionally, so
# an explicit value was silently discarded on any machine that had ever run
# --calibrate; the workaround was to delete the profile. That is no longer
# necessary. A fresh --calibrate / --auto-calibrate sweep is still outside this
# rule: you asked for a measurement, it is printed, and it is what gets saved.
# =============================================================================

# =============================================================================
# Main Configuration
# =============================================================================

# Index n of the Fibonacci number to calculate
# Type: uint64
# Default value: 100000000
FIBCALC_N=100000000

# Algorithm to use for calculation
# Possible values: "all", "fast", "matrix", "fft"
# Type: string
# Default value: "all"
FIBCALC_ALGO=all

# Maximum timeout for calculation
# Format: Go duration (e.g., "5m", "30s", "1h30m")
# Type: duration
# Default value: "5m"
FIBCALC_TIMEOUT=5m

# =============================================================================
# Performance and Parallelism Thresholds
# =============================================================================

# Threshold (in bits) to enable parallelism in multiplications
# 0 = auto (hardware-adaptive estimation; internal static default: 4096)
# -1 = disable parallelism entirely (config.ThresholdDisabled). This is the
#      value calibration persists when its sequential baseline wins; it is
#      accepted by the validator since the 2026-09 audit (H-02), which is what
#      makes such a profile usable instead of silently discarded at startup.
# Type: int
# Default value: 0
FIBCALC_THRESHOLD=0

# Threshold (in bits) to enable FFT multiplication
# 0 = auto (hardware-adaptive estimation; internal static default: 500000)
# -1 = disable FFT entirely (see FIBCALC_THRESHOLD above)
# Type: int
# Default value: 0
FIBCALC_FFT_THRESHOLD=0

# Threshold (in bits) to switch to Strassen algorithm in matrix multiplication
# 0 = auto (hardware-adaptive estimation; internal static default: 3072)
# NOTE: unlike the two thresholds above, -1 is REJECTED here. multiplyMatrices
# compares `maxBitLen <= strassenThreshold`, so a negative value would force
# Strassen on every multiplication rather than disabling it.
# Type: int
# Default value: 0
FIBCALC_STRASSEN_THRESHOLD=0

# =============================================================================
# Calibration
# =============================================================================

# Enable calibration mode to determine the optimal parallelism threshold
# Type: bool
# Default value: false
FIBCALC_CALIBRATE=false

# Enable automatic calibration at startup
# May increase load time
# Type: bool
# Default value: false
FIBCALC_AUTO_CALIBRATE=false

# Path to the calibration profile file
# If empty, uses the default path: ~/.fibcalc_calibration.json
# Type: string
# Default value: ""
FIBCALC_CALIBRATION_PROFILE=

# Freshness window for the calibration profile. A profile older than this
# is considered stale (IsStale) and triggers re-calibration via the
# CompleteStrategy on the next --auto-calibrate run.
# Format: Go duration (e.g., "168h", "24h"). A value that fails to parse, or
# that is zero or negative, falls back to the 168h default — staleness cannot
# be disabled through this variable (profileMaxAgeFromEnv,
# internal/calibration/calibration.go:profileMaxAgeFromEnv).
# Type: duration
# Default value: "168h" (7 days)
FIBCALC_PROFILE_MAX_AGE=168h

# =============================================================================
# Output Options
# =============================================================================

# Display the full result value (can be very long)
# Type: bool
# Default value: false
FIBCALC_VERBOSE=false

# Display performance details and result metadata
# Type: bool
# Default value: false
FIBCALC_DETAILS=false

# Quiet mode - minimal output for scripts
# Suppresses progress bars, banners, and informative messages
# Type: bool
# Default value: false
FIBCALC_QUIET=false

# Display the calculated value (disabled by default)
# Type: bool
# Default value: false
FIBCALC_CALCULATE=false

# Output file path to save the result
# Type: string
# Default value: ""
FIBCALC_OUTPUT=

# Emit machine-readable output (stable line-based format for scripting)
# Type: bool
# Default value: false
FIBCALC_MACHINE_OUTPUT=false

# Memory budget ceiling for the calculation (pre-flight estimation)
# Accepts a SINGLE-LETTER suffix only: K, M or G (case-insensitive), e.g.
# "4G", "512M", or a bare byte count. Multi-letter suffixes such as "4GB"
# or "512MB" are rejected (invalid memory limit, exit code 4).
# If the estimated peak memory exceeds this value, the tool exits with
# an error and suggests --last-digits K as an alternative.
# Type: string
# Default value: "" (unbounded)
FIBCALC_MEMORY_LIMIT=

# GC control during the calculation
# Possible values: "auto" (default), "aggressive", "disabled"
# "auto" disables GC for large calculations and restores it afterwards.
# Type: string
# Default value: "auto"
FIBCALC_GC_CONTROL=auto

# Compute only the last K decimal digits (O(K) memory)
# 0 computes the full value. Incompatible with FIBCALC_TUI.
# Type: int
# Default value: 0
FIBCALC_LAST_DIGITS=0

# =============================================================================
# Interface Options
# =============================================================================

# Enable interactive TUI dashboard (btop-style)
# Activates an alternate full-screen terminal UI with real-time metrics
# Type: bool
# Default value: false
FIBCALC_TUI=false

# TUI color palette
# Possible values: "" (dark, default), "high-contrast" or "highcontrast"
# (accessible palette). Matching is case-insensitive and surrounding spaces are
# trimmed; anything else falls back to the dark palette. When the active CLI
# theme is "none" (--quiet, --machine, or NO_COLOR), the no-color TUI palette
# wins and this variable is ignored.
# Read by internal/ui.GetCurrentTUITheme() at TUI startup
# (internal/ui/themes.go:GetCurrentTUITheme).
# Type: string
# Default value: "" (dark)
FIBCALC_TUI_THEME=

# Note: Use the standard NO_COLOR environment variable to disable colored output
# (see https://no-color.org/). Any value (even empty) disables colors.

# =============================================================================
# Standard Environment Variables
# =============================================================================

# Standard environment variable to disable colors
# Used by many CLI applications
# Type: string (any value enables this option)
# Default value: undefined
# NO_COLOR=1

# =============================================================================
# Dynamic Thresholds (opt-in)
# =============================================================================

# Adjust the FFT and parallelism thresholds DURING the calculation, from
# per-iteration timings (internal/fibonacci/threshold).
#
# Off by default, on measurement rather than caution: a -count=8 benchstat run
# puts the CPU difference in the noise at both F(1M) and F(10M) and shows a
# significant +17.9% allocs/op at 1M. The 5-6% gain ADR-0001 relied on came
# from a single-sample run the ADR itself called noisy, and does not reproduce
# (docs/audits/bench-dtm-2026-09.txt).
#
# Until the 2026-09 audit (M-04) there was no way to turn this on at all: the
# option existed in the library but no CLI flag or variable set it.
# Type: bool
# Default value: false
FIBCALC_DYNAMIC_THRESHOLDS=false
