# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/fibcalc

# Build directory
build/
dist/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
*.prof
coverage.*
*.coverprofile
profile.cov
test_results.txt

# A-13: the `coverage.*` glob above is unanchored and also matched
# .github/workflows/coverage.yml, leaving the coverage workflow untracked
# (it never ran on GitHub). Keep the workflow under version control.
!.github/workflows/coverage.yml

# Go profile-guided optimization files
*.pgo
# P1-22: keep the canonical PGO profile checked in — `go build -pgo=auto`
# picks it up implicitly when building ./cmd/fibcalc.
!cmd/fibcalc/default.pgo

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/
.cursor/
.jules/

# Coverage files (non-standard extensions)
cover
coverage
coverage_new

# Worktrees
.worktrees/

# OS Files
.DS_Store
Thumbs.db

# Temporary files
*.bak
*.swp
*.tmp
*.log

# Runtime artifacts
__pycache__/
*.pyc

# Ruflo/MCP tooling memory graph — local tooling artifact, not project source.
# Was accidentally committed by an external tooling auto-commit (e74e2ec);
# untracked via `git rm --cached` (file kept on disk + in history, reversible).
ruvector.db

# Documentation artifacts
doc/
godoc.log

# Benchmarking artifacts
lru_benchmark.png

# Development logs and test binaries (P1-20)
*_err.txt
*_out.txt
*.test.exe
fibonacci.test.exe
build_err.txt
test_err.txt
test_out.txt
e2e_rich_out.txt
